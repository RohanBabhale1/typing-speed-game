# Copy this file to .env at the repo root, then run `docker compose up --build`

# --- Postgres (used by the db service, and folded into DATABASE_URL below) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=typing_speed_game

# --- Backend ---
# Must match the values above; hostname "db" is the docker-compose service name.
DATABASE_URL=postgresql://postgres:postgres@db:5432/typing_speed_game?schema=public
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
BACKEND_PORT=4000
FRONTEND_URL=http://localhost:5173